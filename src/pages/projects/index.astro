---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = (await getCollection("projects")).sort((a, b) => {
  const ao = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const bo = b.data.order ?? Number.MAX_SAFE_INTEGER;
  return ao !== bo ? ao - bo : a.data.title.localeCompare(b.data.title, "zh");
});

const running = projects.filter(p => p.data.status === "运行中");
const others = projects.filter(p => p.data.status !== "运行中");
---

<Layout
  title={`${t.nav.projects} | ${config.site.title}`}
  description={t.nav.projects}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.nav.projects}>
    {
      projects.length === 0 ? (
        <p class="text-muted-foreground">暂无项目。</p>
      ) : (
        <>
          <section>
            <ul>
              {running.map(entry => (
                <ProjectCard {...entry} />
              ))}
            </ul>
          </section>
          {others.length > 0 && (
            <section class="mt-10">
              <h2 class="text-muted-foreground text-lg font-medium">其他</h2>
              <ul>
                {others.map(entry => (
                  <ProjectCard {...entry} />
                ))}
              </ul>
            </section>
          )}
        </>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
      </LinkButton>
    </div>
  </Main>
  <Footer />
</Layout>
